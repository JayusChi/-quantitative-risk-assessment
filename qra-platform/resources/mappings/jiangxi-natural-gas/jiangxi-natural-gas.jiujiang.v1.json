    "metadata": {
      "data_classification": "REAL_PROJECT_CONVERTED_SOURCE_WITH_EXPLICIT_GAPS",
      "formal_qra_allowed": false,
      "conversion_scope": "仅限九江支线 GDBZYQ-JJ-1；同表其他管线记录必须由行过滤排除。",
      "warning": "本黄金候选只采用台账可直接追溯的全线边界。现场照片变化点缺少权威里程，不生成11个内部计算管段；人口坐标、昼夜分布和室内外比例未获证据，不生成population_cells。",
      "explicit_data_gaps": [
        "权威内部管段起止里程或测绘坐标缺失",
        "人口受体坐标缺失",
        "人口昼夜分布缺失",
        "人口室内外比例缺失",
        "运行压力仅有3.0-3.8 MPa范围，未擅自折算为单值",
        "运行温度、逐段壁厚和阀门里程缺失",
        "照片和视频无GPS地理参照，不能用于里程换算"
      ]
    },
    "pipeline": {
      "operating_pressure_data_status": "SOURCE_RANGE_ONLY_NOT_COLLAPSED",
      "operating_temperature_data_status": "MISSING",
      "wall_thickness_data_status": "MISSING",
      "population_spatial_data_status": "MISSING"
    }
  },
  "manual_review": {
    "confidence_threshold": 0.9
  },
  "source_priorities": [
