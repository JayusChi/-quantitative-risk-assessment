{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qra.local/schemas/report-draft-v1.schema.json",
  "title": "QRA controlled report draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_version", "generation_mode", "provider_id", "sections"],
  "properties": {
    "schema_version": {"const": "report-draft-v1"},
    "prompt_version": {"const": "qra-controlled-report-prompt-v1"},
    "generation_mode": {"enum": ["MODEL_STRUCTURED", "DETERMINISTIC_TEMPLATE_FALLBACK"]},
    "provider_id": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "heading", "paragraphs"],
        "properties": {
          "section_id": {"type": "string"},
          "heading": {"type": "string"},
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "paragraph_id",
                "text_template",
                "metric_refs",
                "evidence_refs",
                "result_refs",
                "uncertainty_refs",
                "prohibited_claim_check"
              ],
              "properties": {
                "paragraph_id": {"type": "string"},
                "text_template": {"type": "string", "minLength": 1},
                "metric_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "uncertainty_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "prohibited_claim_check": {"const": true}
              }
            }
          }
        }
      }
    }
  }
}
